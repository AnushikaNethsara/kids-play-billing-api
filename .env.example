NODE_ENV=development
PORT=4000

# MongoDB Atlas free-tier connection string, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/kids_play_area?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kids_play_area

# JWT secrets - generate strong random values, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed origins for CORS
# Include the local and deployed Next.js admin app origins. Native RN apps do not
# send an Origin header so they are unaffected by this list.
CORS_ORIGINS=http://localhost:3000

BUSINESS_TIMEZONE=Asia/Colombo

LOG_LEVEL=info
